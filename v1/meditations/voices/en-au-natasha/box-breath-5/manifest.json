    {
      "index": 0,
      "text": "Welcome.",
      "file": "c000.ogg",
      "durationSec": 1.439
    },
    {
      "index": 1,
      "text": "Find a comfortable seat, or lie down if that feels better.",
      "file": "c001.ogg",
      "durationSec": 5.506
    },
    {
      "index": 2,
      "text": "Let the hands rest.",
      "file": "c002.ogg",
      "durationSec": 2.663
    },
    {
      "index": 3,
      "text": "Soften the eyes, or close them.",
      "file": "c003.ogg",
      "durationSec": 3.637
    },
    {
      "index": 4,
      "text": "Take a slow breath in.",
      "file": "c004.ogg",
      "durationSec": 2.655
    },
    {
      "index": 5,
      "text": "And a longer breath out.",
      "file": "c005.ogg",
      "durationSec": 2.239
    },
    {
      "index": 6,
      "text": "We will breathe in a simple box.",
      "file": "c006.ogg",
      "durationSec": 3.472
    },
    {
      "index": 7,
      "text": "In for four. Hold for four. Out for four. Hold for four.",
      "file": "c007.ogg",
      "durationSec": 6.539
    },
    {
      "index": 8,
      "text": "Stay gentle. Never strain.",
      "file": "c008.ogg",
      "durationSec": 3.702
    },
    {
      "index": 9,
      "text": "[pause:20]",
      "file": "c009.ogg",
      "durationSec": 20.0,
      "silence": true
    },
    {
      "index": 10,
      "text": "Inhale. Two. Three. Four.",
      "file": "c010.ogg",
      "durationSec": 3.875
    },
    {
      "index": 11,
      "text": "Hold. Two. Three. Four.",
      "file": "c011.ogg",
      "durationSec": 2.482
    },
    {
      "index": 12,
      "text": "Exhale. Two. Three. Four.",
      "file": "c012.ogg",
      "durationSec": 2.996
    },
    {
      "index": 13,
      "text": "Hold. Two. Three. Four.",
