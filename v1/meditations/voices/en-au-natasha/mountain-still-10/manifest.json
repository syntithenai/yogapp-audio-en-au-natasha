    {
      "index": 22,
      "text": "[pause:57]",
      "file": "c022.ogg",
      "durationSec": 57.0,
      "silence": true
    },
    {
      "index": 23,
      "text": "Feel the base of your body rooted.",
      "file": "c023.ogg",
      "durationSec": 3.819
    },
    {
      "index": 24,
      "text": "Feel height in the spine without strain.",
