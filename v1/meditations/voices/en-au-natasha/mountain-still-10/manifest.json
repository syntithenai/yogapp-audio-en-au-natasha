      "file": "c012.ogg",
      "durationSec": 36.0,
      "silence": true
    },
    {
      "index": 13,
      "text": "Imagine yourself as a mountain.",
      "file": "c013.ogg",
      "durationSec": 3.589
    },
    {
      "index": 14,
      "text": "Base wide. Peak quiet. Vast patience.",
      "file": "c014.ogg",
      "durationSec": 5.739
    },
    {
      "index": 15,
      "text": "[pause:43]",
      "file": "c015.ogg",
      "durationSec": 43.0,
      "silence": true
    },
    {
      "index": 16,
      "text": "Weather moves across the mountain.",
      "file": "c016.ogg",
      "durationSec": 3.527
    },
    {
      "index": 17,
      "text": "Sun. Wind. Cloud. Storm.",
      "file": "c017.ogg",
      "durationSec": 4.104
    },
    {
      "index": 18,
      "text": "The mountain remains.",
