      "file": "c004.ogg",
      "durationSec": 3.291
    },
    {
      "index": 5,
      "text": "Slow breath in.",
      "file": "c005.ogg",
      "durationSec": 2.253
    },
    {
      "index": 6,
      "text": "Longer breath out.",
      "file": "c006.ogg",
