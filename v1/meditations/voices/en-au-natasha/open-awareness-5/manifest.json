  "chunks": [
    {
      "index": 0,
      "text": "Welcome.",
      "file": "c000.ogg",
      "durationSec": 1.438
    },
    {
      "index": 1,
      "text": "Find a comfortable seat, or lie down if that feels better.",
      "file": "c001.ogg",
      "durationSec": 5.609
    },
    {
      "index": 2,
      "text": "Let the hands rest.",
      "file": "c002.ogg",
      "durationSec": 2.654
    },
    {
      "index": 3,
      "text": "Soften the eyes, or close them.",
      "file": "c003.ogg",
      "durationSec": 3.587
    },
    {
      "index": 4,
      "text": "Take a slow breath in.",
      "file": "c004.ogg",
      "durationSec": 2.658
    },
    {
      "index": 5,
      "text": "And a longer breath out.",
      "file": "c005.ogg",
      "durationSec": 2.887
    },
    {
      "index": 6,
      "text": "Start with the breath for a few cycles.",
      "file": "c006.ogg",
      "durationSec": 4.051
    },
    {
      "index": 7,
      "text": "[pause:28]",
      "file": "c007.ogg",
      "durationSec": 28.0,
      "silence": true
    },
    {
      "index": 8,
      "text": "Now widen. Include sounds.",
      "file": "c008.ogg",
      "durationSec": 3.882
    },
    {
      "index": 9,
      "text": "Near. Far. Changing. Steady.",
      "file": "c009.ogg",
      "durationSec": 3.761
    },
    {
      "index": 10,
      "text": "[pause:28]",
      "file": "c010.ogg",
      "durationSec": 28.0,
      "silence": true
    },
    {
      "index": 11,
      "text": "Include sensations in the body.",
      "file": "c011.ogg",
      "durationSec": 3.759
    },
    {
      "index": 12,
      "text": "Contact points. Temperature. Soft pulse.",
      "file": "c012.ogg",
      "durationSec": 4.967
    },
    {
      "index": 13,
      "text": "[pause:28]",
      "file": "c013.ogg",
      "durationSec": 28.0,
      "silence": true
    },
    {
      "index": 14,
      "text": "Include the space of the room.",
      "file": "c014.ogg",
      "durationSec": 3.291
    },
    {
      "index": 15,
      "text": "Awareness like open sky.",
      "file": "c015.ogg",
      "durationSec": 3.289
    },
    {
      "index": 16,
      "text": "[pause:34]",
      "file": "c016.ogg",
      "durationSec": 34.0,
      "silence": true
    },
    {
      "index": 17,
      "text": "Thoughts may appear like weather.",
      "file": "c017.ogg",
      "durationSec": 3.357
    },
    {
      "index": 18,
      "text": "No need to chase or push them.",
      "file": "c018.ogg",
      "durationSec": 3.06
    },
    {
      "index": 19,
      "text": "Sky remains.",
      "file": "c019.ogg",
      "durationSec": 2.066
    },
    {
      "index": 20,
      "text": "[pause:45]",
      "file": "c020.ogg",
      "durationSec": 45.0,
      "silence": true
    },
    {
      "index": 21,
      "text": "Rest in this open field.",
      "file": "c021.ogg",
      "durationSec": 2.952
    },
    {
      "index": 22,
      "text": "[pause:45]",
      "file": "c022.ogg",
      "durationSec": 45.0,
      "silence": true
    },
    {
      "index": 23,
      "text": "Take one more easy breath.",
      "file": "c023.ogg",
      "durationSec": 2.364
    },
    {
      "index": 24,
      "text": "Wiggle the fingers.",
      "file": "c024.ogg",
      "durationSec": 2.244
    },
    {
      "index": 25,
      "text": "When you are ready, open the eyes.",
      "file": "c025.ogg",
      "durationSec": 4.514
    },
    {
      "index": 26,
      "text": "Carry a little of this with you.",
      "file": "c026.ogg",
      "durationSec": 3.002
    }
  ],
