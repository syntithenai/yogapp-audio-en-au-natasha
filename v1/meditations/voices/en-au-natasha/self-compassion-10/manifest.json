{
  "id": "self-compassion-10",
  "voiceId": "en-au-natasha",
  "edgeVoice": "en-AU-NatashaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 585,
  "chunks": [
    {
      "index": 0,
      "text": "Welcome.",
      "file": "c000.ogg",
      "durationSec": 1.438
    },
    {
      "index": 1,
      "text": "Take time to arrive.",
      "file": "c001.ogg",
      "durationSec": 2.304
    },
    {
      "index": 2,
      "text": "Sit or lie down with support.",
      "file": "c002.ogg",
      "durationSec": 3.412
    },
    {
      "index": 3,
      "text": "Close the eyes if that feels safe.",
      "file": "c003.ogg",
      "durationSec": 3.823
    },
    {
      "index": 4,
      "text": "Feel contact with the ground.",
      "file": "c004.ogg",
      "durationSec": 3.24
    },
    {
      "index": 5,
      "text": "Slow breath in.",
      "file": "c005.ogg",
      "durationSec": 2.254
    },
    {
      "index": 6,
      "text": "Longer breath out.",
      "file": "c006.ogg",
      "durationSec": 2.356
    },
    {
      "index": 7,
      "text": "[pause:26]",
      "file": "c007.ogg",
      "durationSec": 26.0,
      "silence": true
    },
    {
      "index": 8,
      "text": "Again.",
      "file": "c008.ogg",
      "durationSec": 1.431
    },
    {
      "index": 9,
      "text": "[pause:26]",
      "file": "c009.ogg",
      "durationSec": 26.0,
      "silence": true
    },
    {
      "index": 10,
      "text": "Let the shoulders drop.",
      "file": "c010.ogg",
      "durationSec": 2.658
    },
    {
      "index": 11,
      "text": "Let the belly soften.",
      "file": "c011.ogg",
      "durationSec": 2.71
    },
    {
      "index": 12,
      "text": "[pause:32]",
      "file": "c012.ogg",
      "durationSec": 32.0,
      "silence": true
    },
    {
      "index": 13,
      "text": "Hand on heart, if that helps.",
      "file": "c013.ogg",
      "durationSec": 2.825
    },
    {
      "index": 14,
      "text": "Notice your state without judgment.",
      "file": "c014.ogg",
      "durationSec": 3.71
    },
    {
      "index": 15,
      "text": "[pause:32]",
      "file": "c015.ogg",
      "durationSec": 32.0,
      "silence": true
    },
    {
      "index": 16,
      "text": "This is a moment of suffering, or of ordinary human strain.",
      "file": "c016.ogg",
      "durationSec": 7.058
    },
    {
      "index": 17,
      "text": "Others feel this too.",
      "file": "c017.ogg",
      "durationSec": 2.483
    },
    {
      "index": 18,
      "text": "[pause:39]",
      "file": "c018.ogg",
      "durationSec": 39.0,
      "silence": true
    },
    {
      "index": 19,
      "text": "May I be kind to myself in this moment.",
      "file": "c019.ogg",
      "durationSec": 4.103
    },
    {
      "index": 20,
      "text": "[pause:32]",
      "file": "c020.ogg",
      "durationSec": 32.0,
      "silence": true
    },
    {
      "index": 21,
      "text": "May I accept myself as I am.",
      "file": "c021.ogg",
      "durationSec": 3.643
    },
    {
      "index": 22,
      "text": "[pause:32]",
      "file": "c022.ogg",
      "durationSec": 32.0,
      "silence": true
    },
    {
      "index": 23,
      "text": "May I give myself the compassion I need.",
      "file": "c023.ogg",
      "durationSec": 4.397
    },
    {
      "index": 24,
      "text": "[pause:39]",
      "file": "c024.ogg",
      "durationSec": 39.0,
      "silence": true
    },
    {
      "index": 25,
      "text": "Repeat the phrases that land. Leave the ones that do not.",
      "file": "c025.ogg",
      "durationSec": 6.773
    },
    {
      "index": 26,
      "text": "[pause:52]",
      "file": "c026.ogg",
      "durationSec": 52.0,
      "silence": true
    },
    {
      "index": 27,
      "text": "Imagine speaking to yourself as a wise friend would.",
      "file": "c027.ogg",
      "durationSec": 5.447
    },
    {
      "index": 28,
      "text": "What tone would they use?",
      "file": "c028.ogg",
      "durationSec": 2.83
    },
    {
      "index": 29,
      "text": "Offer yourself that tone now.",
      "file": "c029.ogg",
      "durationSec": 3.404
    },
    {
      "index": 30,
      "text": "[pause:65]",
      "file": "c030.ogg",
      "durationSec": 65.0,
      "silence": true
    },
    {
      "index": 31,
      "text": "Breathe kindness in.",
      "file": "c031.ogg",
      "durationSec": 2.715
    },
    {
      "index": 32,
      "text": "Breathe harshness out.",
      "file": "c032.ogg",
      "durationSec": 2.593
    },
    {
      "index": 33,
      "text": "[pause:78]",
      "file": "c033.ogg",
      "durationSec": 78.0,
      "silence": true
    },
    {
      "index": 34,
      "text": "[pause:39]",
      "file": "c034.ogg",
      "durationSec": 39.0,
      "silence": true
    },
    {
      "index": 35,
      "text": "Begin to deepen the breath.",
      "file": "c035.ogg",
      "durationSec": 2.298
    },
    {
      "index": 36,
      "text": "Feel the room again.",
      "file": "c036.ogg",
      "durationSec": 2.414
    },
    {
      "index": 37,
      "text": "Wiggle fingers and toes.",
      "file": "c037.ogg",
      "durationSec": 2.993
    },
    {
      "index": 38,
      "text": "When ready, open the eyes.",
      "file": "c038.ogg",
      "durationSec": 3.296
    },
    {
      "index": 39,
      "text": "Move slowly into what comes next.",
      "file": "c039.ogg",
      "durationSec": 3.989
    }
  ],
